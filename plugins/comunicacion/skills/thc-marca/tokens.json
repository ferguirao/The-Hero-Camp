{
  "fuente": "Variante v2 de la portada web (thc-notion-experimento.vercel.app/lab/portada/)",
  "color": {
    "ink": "#003133",
    "ink2": "#0B4648",
    "lime": "#98DA01",
    "pink": "#E83B83",
    "yellow": "#FFDA23",
    "paper": "#F4F6F5",
    "pale": "#EAFFBF",
    "white": "#FFFFFF",
    "gris": "#486461",
    "cuerpo": "#19494B",
    "linea": "#C9D6D3",
    "sobre-oscuro": "#C5D8D5",
    "rotulo-oscuro": "#9FBAB6"
  },
  "texto-por-fondo": {
    "paper": {
      "titular": "ink",
      "parrafo": "cuerpo",
      "secundario": "gris",
      "manuscrito": "pink",
      "destacado": "subrayado lime",
      "boton": "lime, sombra ink"
    },
    "white": {
      "titular": "ink",
      "parrafo": "cuerpo",
      "secundario": "gris",
      "manuscrito": "pink",
      "destacado": "subrayado lime",
      "boton": "lime, sombra ink"
    },
    "ink": {
      "titular": "white",
      "parrafo": "white",
      "secundario": "sobre-oscuro",
      "manuscrito": "yellow",
      "destacado": "texto lime",
      "boton": "lime, sombra white"
    },
    "pale": {
      "titular": "ink",
      "parrafo": "cuerpo",
      "secundario": "gris",
      "manuscrito": "pink",
      "destacado": "subrayado lime",
      "boton": "ink con texto white, sombra lime"
    },
    "lime": {
      "todo": "ink"
    },
    "yellow": {
      "todo": "ink"
    }
  },
  "tipografia": {
    "sans": "DM Sans",
    "mano": "Permanent Marker",
    "h1": {
      "size": "clamp(42px,5.4vw,80px)",
      "weight": 700,
      "lineHeight": 1.04,
      "letterSpacing": "-0.045em"
    },
    "h2": {
      "size": "clamp(30px,3.5vw,50px)",
      "weight": 700,
      "lineHeight": 1.08,
      "letterSpacing": "-0.04em"
    },
    "h3": {
      "size": "24px",
      "weight": 700,
      "lineHeight": 1.15,
      "letterSpacing": "-0.03em"
    },
    "entradilla": {
      "size": "20px",
      "weight": 400,
      "lineHeight": 1.5,
      "color": "cuerpo",
      "maxWidth": "44ch"
    },
    "parrafo": {
      "size": "18px",
      "weight": 400,
      "lineHeight": 1.55
    },
    "boton": {
      "size": "17px",
      "weight": 700
    },
    "nav": {
      "size": "15.5px",
      "weight": 500
    },
    "cifra": {
      "size": "clamp(40px,4.6vw,64px)",
      "weight": 700,
      "letterSpacing": "-0.05em"
    },
    "rotulo": {
      "size": "12.5px",
      "weight": 700,
      "transform": "uppercase",
      "letterSpacing": "0.08em"
    },
    "eyebrow": {
      "family": "Permanent Marker",
      "size": "19px",
      "color": "pink sobre claro, yellow sobre oscuro"
    }
  },
  "bordes": {
    "principal": "2px solid ink",
    "pequeno": "1.5px solid ink",
    "fino": "1px solid linea",
    "fino-oscuro": "1px solid rgba(255,255,255,.2)",
    "radio": 0,
    "radio-chip": "99px"
  },
  "sombras": {
    "tarjeta": "5px 5px 0 ink",
    "boton": "4px 4px 0 ink",
    "pequeno": "3px 3px 0 ink",
    "destacado": "5px 5px 0 lime",
    "boton-sobre-oscuro": "4px 4px 0 white",
    "hover": "translate(-2px,-2px) + sombra 6px"
  },
  "boton": {
    "padding": "13px 22px",
    "fondo": "lime",
    "texto": "ink",
    "borde": "2px solid ink",
    "sombra": "4px 4px 0 ink",
    "radio": 0,
    "secundario": "fondo white"
  },
  "espaciado": {
    "contenedor": "min(1240px, 100% - 64px)",
    "seccion": "clamp(64px,8.5vw,120px)",
    "rejilla": "22-24px",
    "tarjeta-padding": "18-22px",
    "cabecera-seccion": "grid 1.25fr 1fr, gap 64px"
  }
}